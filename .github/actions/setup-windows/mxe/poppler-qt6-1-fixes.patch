From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Stefan=20L=C3=B6ffler?= <st.loeffler@gmail.com>
Date: Sat, 26 Jun 2021 19:49:25 +0200
Subject: [PATCH 1/3] Fix static builds


diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1111111..2222222 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -93,7 +93,7 @@ option(RUN_GPERF_IF_PRESENT "Run gperf if it is found" ON)
 option(INSTALL_GLIB_DEMO "Whether to install the poppler-glib-demo program." OFF)
 option(ENABLE_HARFBUZZ "Build with support for font subsetting (uses Harfbuzz)" ON)
 if(WIN32)
-  option(ENABLE_RELOCATABLE "Do not hardcode the poppler library location (on Windows)." ON)
+  option(ENABLE_RELOCATABLE "Do not hardcode the poppler library location (on Windows)." ${BUILD_SHARED_LIBS})
 else()
   set(ENABLE_RELOCATABLE OFF)
 endif()

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "fix@me" <fix@me>
Date: Fri, 5 May 2023 18:00:00 +0200
Subject: [PATCH 2/3] Fix static builds involving qtimageformats


diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1111111..2222222 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -219,7 +219,7 @@ find_soft_mandatory_package(ENABLE_QT5 Qt5Xml ${QT5_REQUIRED_VERSION})
 find_soft_mandatory_package(BUILD_QT5_TESTS Qt5Widgets ${QT5_REQUIRED_VERSION})
 find_soft_mandatory_package(BUILD_QT5_TESTS Qt5Test ${QT5_REQUIRED_VERSION})
 
-SET(QT_NO_CREATE_VERSIONLESS_TARGETS ON)
+SET(QT_NO_CREATE_VERSIONLESS_TARGETS ${BUILD_SHARED_LIBS})
 find_soft_mandatory_package(ENABLE_QT6 Qt6Core ${QT6_REQUIRED_VERSION})
 find_soft_mandatory_package(ENABLE_QT6 Qt6Gui ${QT6_REQUIRED_VERSION})
 find_soft_mandatory_package(BUILD_QT6_TESTS Qt6Widgets ${QT6_REQUIRED_VERSION})

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Stefan=20L=C3=B6ffler?= <st.loeffler@gmail.com>
Date: Sat, 7 Nov 2026 20:13:00 +0100
Subject: [PATCH 3/3] Fix CMake alias targets for harfbuzz


diff --git a/cmake/modules/Findharfbuzz.cmake b/cmake/modules/Findharfbuzz.cmake
index 1111111..2222222 100644
--- a/cmake/modules/Findharfbuzz.cmake
+++ b/cmake/modules/Findharfbuzz.cmake
@@ -20,8 +20,12 @@ pkg_check_modules(harfbuzz-subset IMPORTED_TARGET harfbuzz-subset)
 
 find_package_handle_standard_args(harfbuzz-subset NAME_MISMATCHED REQUIRED_VARS harfbuzz-subset_LINK_LIBRARIES harfbuzz-subset_CFLAGS)
 
+if (NOT TARGET harfbuzz::harfbuzz)
 add_library(harfbuzz::harfbuzz ALIAS PkgConfig::harfbuzz)
+endif ()
+if (NOT TARGET harfbuzz::subset)
 add_library(harfbuzz::subset ALIAS PkgConfig::harfbuzz-subset)
+endif()
 if (NOT harfbuzz-subset_FOUND)
 set (harfbuzz_FOUND false)
 endif()
